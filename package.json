{
  "name": "daggerheart-companion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Offline-first digital character sheet and GM tools for Daggerheart. Local-first, no accounts, no network.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:srd": "tsx tools/build-srd.ts",
    "build:registry": "tsx tools/buildRegistry.ts",
    "build:icons": "tsx tools/makeIcons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^5.4.149",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "jsdom": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
